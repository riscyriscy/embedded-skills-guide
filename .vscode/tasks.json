{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "workflow ci-host",
            "type": "shell",
            "command": "cmake --workflow --preset ci-host",
            "group": { "kind": "test", "isDefault": true },
            "problemMatcher": "$gcc"
        },
        {
            "label": "workflow ci-m4",
            "type": "shell",
            "command": "cmake --workflow --preset ci-m4",
            "group": "build",
            "problemMatcher": "$gcc"
        },
        {
            "label": "build m4-debug",
            "type": "shell",
            "command": "cmake --preset m4-release -B build/m4-debug -DCMAKE_BUILD_TYPE=Debug && cmake --build build/m4-debug",
            "problemMatcher": "$gcc"
        },
        {
            "label": "qemu gdb server",
            "type": "shell",
            "command": "qemu-system-arm -machine mps2-an386 -nographic -semihosting-config enable=on,target=native -S -gdb tcp::1234 -kernel build/m4-debug/app/sensor_demo",
            "isBackground": true,
            "dependsOn": ["build m4-debug"],
            "problemMatcher": {
                "pattern": { "regexp": "^$" },
                "background": { "activeOnStart": true, "beginsPattern": "^$", "endsPattern": "^$" }
            }
        }
    ]
}
