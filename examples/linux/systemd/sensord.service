[Unit]
Description=Sensor sampling service
Documentation=file:///usr/share/doc/sensord/README
# the service reads its period from /etc and writes nothing, so it needs only the root file system
RequiresMountsFor=/etc
# At most five starts in a minute. These two settings belong to the [Unit] section.
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
# The daemon sends READY=1 when it has read its settings, and WATCHDOG=1 once per period.
Type=notify
NotifyAccess=main
ExecStart=/usr/sbin/sensord /etc/sensord.period
ExecReload=/bin/kill -HUP $MAINPID
# Start again after a crash or a watchdog timeout, one second later.
Restart=on-failure
RestartSec=1
WatchdogSec=10
# A user of its own, no powers and a small share of the machine.
DynamicUser=yes
NoNewPrivileges=yes
CapabilityBoundingSet=
MemoryMax=16M
TasksMax=8
# A read-only view of the system.
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
UMask=0077

[Install]
WantedBy=multi-user.target
