#!/bin/sh
# A service script in the style of init.d: start, stop, restart, reload and status.
NAME=sensord
DAEMON=/usr/sbin/sensord
PIDFILE=/run/$NAME.pid
LOG=/var/log/$NAME.log

start() {
    echo "Starting $NAME"
    start-stop-daemon -S -b -m -p $PIDFILE -x /bin/sh -- -c "exec $DAEMON >>$LOG 2>&1"
}
stop() {
    echo "Stopping $NAME"
    start-stop-daemon -K -p $PIDFILE -x $DAEMON -R TERM/5/KILL/1
    rm -f $PIDFILE
}
case "$1" in
start) start ;;
stop) stop ;;
restart) stop; start ;;
reload) start-stop-daemon -K -q -s HUP -p $PIDFILE -x $DAEMON ;;
status)
    if start-stop-daemon -K -t -p $PIDFILE -x $DAEMON >/dev/null 2>&1; then
        echo "$NAME is running, pid $(cat $PIDFILE)"
    else
        echo "$NAME is not running"
        exit 3
    fi
    ;;
*)
    echo "usage: $0 {start|stop|restart|reload|status}" >&2
    exit 2
    ;;
esac
