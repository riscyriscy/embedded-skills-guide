{
  "version": 6,
  "configurePresets": [
    {
      "name": "host",
      "displayName": "Host build",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/../../build/flaky",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    }
  ],
  "buildPresets": [
    { "name": "host", "configurePreset": "host" }
  ],
  "testPresets": [
    {
      "name": "gate",
      "displayName": "Tests that stop a merge",
      "configurePreset": "host",
      "output": { "outputOnFailure": true },
      "filter": { "exclude": { "label": "quarantine" } }
    },
    {
      "name": "quarantine",
      "displayName": "Quarantined tests, which never stop a merge",
      "configurePreset": "host",
      "output": { "outputOnFailure": true },
      "filter": { "include": { "label": "quarantine" } }
    }
  ]
}
