# The image of the pipeline: the build image of Chapter 11 and the tools for tests, coverage and static checks.
FROM sensorfw-build:1

# The host compiler needs the C library headers and start files, which gcc only recommends.
RUN apt-get update && apt-get install -y --no-install-recommends \
        libc6-dev \
        libcmocka-dev=1.1.7-3 \
        cppcheck=2.13.0-2ubuntu3 \
        shellcheck=0.9.0-1 \
        clang-format-18=1:18.1.3-1ubuntu1 \
        clang-tidy-18=1:18.1.3-1ubuntu1 \
        python3 \
        python3-venv \
    && ln -s clang-format-18 /usr/bin/clang-format \
    && ln -s ../lib/llvm-18/bin/clang-tidy /usr/bin/clang-tidy \
    && rm -rf /var/lib/apt/lists/*

# gcovr comes from PyPI at the version of Chapter 13, in a virtual environment of its own.
RUN python3 -m venv /opt/gcovr && /opt/gcovr/bin/pip install --no-cache-dir gcovr==8.8 \
    && ln -s /opt/gcovr/bin/gcovr /usr/local/bin/gcovr

# uv at the version of Chapter 25 sends the reports to the dashboard, in a virtual environment of its own.
RUN python3 -m venv /opt/uv && /opt/uv/bin/pip install --no-cache-dir uv==0.11.32 \
    && ln -s /opt/uv/bin/uv /usr/local/bin/uv
